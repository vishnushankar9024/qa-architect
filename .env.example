# Example environment configuration for QA Architect.
# Copy to ".env" and adjust as needed. All variables are optional for scaffolding.

# QA_ARCHITECT_ENVIRONMENT=development
# QA_ARCHITECT_DEBUG=true

# GitHub integration (optional during scaffolding)
# QA_ARCHITECT_GITHUB_TOKEN=ghp_your_token_here
# QA_ARCHITECT_GITHUB_API_URL=https://api.github.com
